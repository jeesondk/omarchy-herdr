#!/usr/bin/python3
"""Print live Herdr session state as one JSON line, for the jesper.herdr bar widget.

Local host plus any saved remote machines:

    omarchy-herdr-state [--remotes label1,label2]

Local state comes from `herdr api snapshot` / `herdr agent list`. Each remote
label is queried through `herdr --machine <label> ...` (herdr proxies API
commands to the remote server over SSH) and tagged with the label; the
machine's SSH target (for attaching a TUI with `herdr --remote <target>`)
comes from `herdr machine list --json`.

Herdr's recognized-agent list is closed in the server, so a pane running an
agent it doesn't know (e.g. vibe-rs) stays at agent_status "unknown"; for
those panes the foreground process (`herdr ... pane process-info`) identifies
the agent and its own status line (`herdr ... pane read`, e.g.
"ctx 46.4k/800k") gives context usage.

Each host may also run herdr's desktop app, whose terminals live in herdr-core
(`hc`), a separate daemon the herdr server doesn't see. Those come from
`hc ls --json` (over SSH for remotes) and are grouped by their "where" label
("Workspace / tab") into the same workspace -> tab -> pane shape, under
"desktop" on each host.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
from concurrent.futures import ThreadPoolExecutor

HERDR_TIMEOUT_SECONDS = 4
REMOTE_TIMEOUT_SECONDS = 10

PROCESS_AGENT_LABELS = {
  "vibe": "vibe",
  "vibe-rs": "vibe",
  "mistral-vibe": "vibe",
}

# "ctx ▏ 46.4k/800k" on the agent's status line.
CTX_RE = re.compile(r"ctx\s*[^\d\s]*\s*([0-9][0-9.,]*)\s*([kmb])?\s*/\s*([0-9][0-9.,]*)\s*([kmb])?", re.IGNORECASE)
AMOUNT_RE = re.compile(r"^\s*([0-9][0-9.,]*)\s*([kmb])?\s*$", re.IGNORECASE)


def run_json(prefix, *args, timeout=HERDR_TIMEOUT_SECONDS):
  try:
    proc = subprocess.run(["herdr", *prefix, *args], capture_output=True, text=True, timeout=timeout)
  except (OSError, subprocess.TimeoutExpired):
    return None
  if proc.returncode != 0:
    return None
  try:
    envelope = json.loads(proc.stdout)
  except ValueError:
    return None
  if isinstance(envelope, dict) and "result" in envelope:
    return envelope["result"]
  # Some commands (e.g. `machine list --json`) print a bare array/object.
  if isinstance(envelope, (dict, list)):
    return envelope
  return None


def run_text(prefix, *args, timeout=HERDR_TIMEOUT_SECONDS) -> str:
  try:
    proc = subprocess.run(["herdr", *prefix, *args], capture_output=True, text=True, timeout=timeout)
  except (OSError, subprocess.TimeoutExpired):
    return ""
  return proc.stdout if proc.returncode == 0 else ""


def parse_amount(text):
  match = AMOUNT_RE.match(str(text or ""))
  if not match:
    return None
  value = float(match.group(1).replace(",", ""))
  multiplier = {"k": 1e3, "m": 1e6, "b": 1e9}.get((match.group(2) or "").lower(), 1)
  return int(value * multiplier)


def label_from_process_name(name):
  base = str(name or "").strip().lower().rsplit("/", 1)[-1]
  base = re.sub(r"\.(exe|bin)$", "", base)
  return PROCESS_AGENT_LABELS.get(base)


def pane_process_label(prefix, pane_id):
  result = run_json(prefix, "pane", "process-info", "--pane", pane_id) or {}
  for proc in (result.get("process_info") or {}).get("foreground_processes") or []:
    if not isinstance(proc, dict):
      continue
    argv0 = (proc.get("argv") or [""])[0]
    label = label_from_process_name(proc.get("name")) or label_from_process_name(argv0)
    if label:
      return label
  return None


def pane_context_used(prefix, pane_id):
  text = run_text(prefix, "pane", "read", pane_id, "--source", "visible", "--lines", "8")
  match = None
  for match in CTX_RE.finditer(text):
    pass
  if not match:
    return None
  return parse_amount(f"{match.group(1)}{match.group(2) or ''}")


def collect_host(prefix, timeout):
  """One host's (local or remote) workspaces/tabs/panes, or None when the
  host didn't answer."""
  snapshot_result = run_json(prefix, "api", "snapshot", timeout=timeout)
  snapshot = (snapshot_result or {}).get("snapshot")
  if not isinstance(snapshot, dict):
    return None

  agents_result = run_json(prefix, "agent", "list", timeout=timeout) or {}
  agents_by_pane = {
    agent.get("pane_id"): agent
    for agent in agents_result.get("agents") or []
    if isinstance(agent, dict)
  }

  panes = []
  for pane in snapshot.get("panes", []):
    if not isinstance(pane, dict):
      continue
    pane_id = pane.get("pane_id")
    listed = agents_by_pane.get(pane_id) or {}
    agent = listed.get("agent") or pane.get("agent")
    display_agent = listed.get("display_agent") or pane.get("display_agent")
    tokens = listed.get("tokens") or pane.get("tokens")
    status = pane.get("agent_status") or "unknown"
    proc_agent = None
    ctx_used = None
    if status == "unknown" and not agent and not display_agent and pane_id:
      proc_agent = pane_process_label(prefix, pane_id)
      if proc_agent:
        ctx_used = pane_context_used(prefix, pane_id)
    panes.append({
      "id": pane_id,
      "tab_id": pane.get("tab_id"),
      "workspace_id": pane.get("workspace_id"),
      "title": pane.get("terminal_title_stripped") or pane.get("title") or "",
      "cwd": pane.get("cwd") or "",
      "status": status,
      "focused": bool(pane.get("focused")),
      "agent": agent,
      "display_agent": display_agent,
      "proc_agent": proc_agent,
      "tokens": tokens if isinstance(tokens, dict) else {},
      "ctx_used": ctx_used,
    })

  tabs_by_workspace = {}
  for tab in snapshot.get("tabs", []):
    if not isinstance(tab, dict):
      continue
    tabs_by_workspace.setdefault(tab.get("workspace_id"), []).append({
      "id": tab.get("tab_id"),
      "label": tab.get("label") or str(tab.get("number") or ""),
      "number": tab.get("number"),
      "status": tab.get("agent_status") or "unknown",
      "focused": bool(tab.get("focused")),
      "panes": [p for p in panes if p["tab_id"] == tab.get("tab_id")],
    })

  workspaces = []
  for workspace in snapshot.get("workspaces", []):
    if not isinstance(workspace, dict):
      continue
    workspaces.append({
      "id": workspace.get("workspace_id"),
      "label": workspace.get("label") or workspace.get("workspace_id") or "",
      "status": workspace.get("agent_status") or "unknown",
      "focused": bool(workspace.get("focused")),
      "tokens": workspace.get("tokens") if isinstance(workspace.get("tokens"), dict) else {},
      "tabs": tabs_by_workspace.get(workspace.get("workspace_id"), []),
    })

  return {
    "version": snapshot.get("version") or "",
    "focused": {
      "workspace_id": snapshot.get("focused_workspace_id"),
      "tab_id": snapshot.get("focused_tab_id"),
      "pane_id": snapshot.get("focused_pane_id"),
    },
    "workspaces": workspaces,
  }


SHELL_NAMES = {"sh", "bash", "zsh", "fish", "nu", "dash", "ksh", "tcsh", "csh"}

HC_AGENT_LABELS = {
  "claude-code": "claude",
}

# herdr-core status.state -> the panel's herdr agent_status vocabulary.
HC_STATUS = {
  "working": "working",
  "idle": "idle",
  "done": "done",
  "blocked": "blocked",
  "waiting": "blocked",
  "needs_input": "blocked",
  "permission": "blocked",
}

# Finds hc on the remote: ~/.local/bin is where the desktop app installs it and
# isn't on PATH for a non-interactive ssh command. Prints the resolved path on
# the first line so the panel can attach with it.
HC_REMOTE_SCRIPT = (
  'hc="$HOME/.local/bin/hc"; [ -x "$hc" ] || hc="$(command -v hc)" || exit 3; '
  'printf "%s\\n" "$hc"; exec "$hc" ls --json'
)


def ssh_base(target):
  # Own control master so polling every few seconds reuses one connection.
  control_dir = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
  return [
    "ssh", "-T",
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=5",
    "-o", "ControlMaster=auto",
    "-o", f"ControlPath={control_dir}/omarchy-herdr-ssh-%C",
    "-o", "ControlPersist=600",
    target,
  ]


def hc_terminals(target):
  """(hc path, terminal list) from herdr-core on this host (target None) or a
  remote, or (None, None) when there's no hc or it didn't answer."""
  if target:
    command = [*ssh_base(target), HC_REMOTE_SCRIPT]
  else:
    path = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")
    if not os.access(path, os.X_OK):
      return None, None
    command = [path, "ls", "--json"]
  try:
    proc = subprocess.run(command, capture_output=True, text=True, timeout=REMOTE_TIMEOUT_SECONDS, stdin=subprocess.DEVNULL)
  except (OSError, subprocess.TimeoutExpired):
    return None, None
  if proc.returncode != 0:
    return None, None
  out = proc.stdout
  if target:
    path, _, out = out.partition("\n")
  try:
    result = json.loads(out)
  except ValueError:
    return None, None
  terminals = result.get("terminals") if isinstance(result, dict) else None
  if not isinstance(terminals, list):
    return None, None
  return path.strip(), terminals


def hc_agent(term):
  status = term.get("status") if isinstance(term.get("status"), dict) else {}
  app = status.get("app") or term.get("agent") or ""
  app = str(app).strip()
  if not app or app.lower() in SHELL_NAMES:
    return None
  return HC_AGENT_LABELS.get(app, app)


def hc_status(term):
  raw = term.get("status")
  state = raw.get("state") if isinstance(raw, dict) else raw
  return HC_STATUS.get(str(state or ""), "unknown")


def collect_desktop(target):
  """herdr-core terminals as {hc, workspaces}, or None when the host has none."""
  path, terminals = hc_terminals(target)
  if not terminals:
    return None
  workspaces = {}
  for term in terminals:
    if not isinstance(term, dict) or term.get("state", "live") != "live":
      continue
    address = str(term.get("address") or "")
    where = str(term.get("where") or (term.get("labels") or {}).get("where") or "")
    if " / " in where:
      space, tab = where.split(" / ", 1)
    else:
      space = where or os.path.basename(str(term.get("cwd") or "").rstrip("/")) or "~"
      tab = address
    ws = workspaces.setdefault(space, {
      "id": "hc:" + space,
      "label": space,
      "status": "unknown",
      "focused": False,
      "tokens": {},
      "tabs": [],
    })
    status = hc_status(term)
    ws["tabs"].append({
      "id": "hc:" + address,
      "label": tab,
      "number": None,
      "status": status,
      "focused": False,
      "panes": [{
        "id": address,
        "tab_id": "hc:" + address,
        "workspace_id": ws["id"],
        "title": address,
        "cwd": str(term.get("cwd") or ""),
        "status": status,
        "focused": False,
        "agent": hc_agent(term),
        "display_agent": None,
        "proc_agent": None,
        "tokens": {},
        "ctx_used": None,
        "address": address,
      }],
    })
  if not workspaces:
    return None
  return {"hc": path, "workspaces": list(workspaces.values())}


def machine_catalog():
  """label -> {id, target, session} from `herdr machine list --json` (a top-level
  array). The id is what `--machine` needs when a label is ambiguous."""
  result = run_json([], "machine", "list", "--json")
  if isinstance(result, dict) and "result" in result:
    result = result["result"]
  if isinstance(result, dict):
    result = result.get("machines") or []
  if not isinstance(result, list):
    return {}
  catalog = {}
  for machine in result:
    if isinstance(machine, dict) and machine.get("label") and str(machine["label"]) not in catalog:
      catalog[str(machine["label"])] = {
        "id": str(machine.get("id") or ""),
        "target": str(machine.get("target") or ""),
        "session": machine.get("session"),
      }
  return catalog


def main():
  parser = argparse.ArgumentParser(description="Print Herdr session state as JSON")
  parser.add_argument("--remotes", default="", help="comma-separated herdr machine labels to include as remotes")
  args = parser.parse_args()

  labels = [label.strip() for label in args.remotes.split(",") if label.strip()]
  catalog = machine_catalog() if labels else {}

  # Every host is a few seconds of SSH round trips; query them all at once.
  with ThreadPoolExecutor(max_workers=4 + 2 * len(labels)) as pool:
    local_future = pool.submit(collect_host, [], HERDR_TIMEOUT_SECONDS)
    local_desktop_future = pool.submit(collect_desktop, None)
    remote_futures = []
    for label in labels:
      info = catalog.get(label, {})
      # Prefer the profile id: a duplicated label makes `--machine <label>`
      # fail with "ambiguous".
      selector = info.get("id") or label
      target = info.get("target", "")
      remote_futures.append((
        label,
        info,
        pool.submit(collect_host, ["--machine", selector], REMOTE_TIMEOUT_SECONDS),
        pool.submit(collect_desktop, target) if target else None,
      ))

    local = local_future.result()
    local_desktop = local_desktop_future.result()
    remotes = []
    for label, info, host_future, desktop_future in remote_futures:
      host = host_future.result()
      desktop = desktop_future.result() if desktop_future else None
      remotes.append({
        "name": label,
        "target": info.get("target", ""),
        "session": info.get("session"),
        "up": host is not None,
        "workspaces": host["workspaces"] if host else [],
        "desktop": desktop,
      })

  if local is None:
    print(json.dumps({"serverUp": False, "version": "", "focused": {}, "workspaces": [],
                      "desktop": local_desktop, "remotes": remotes}))
    return

  print(json.dumps({
    "serverUp": True,
    "version": local["version"],
    "focused": local["focused"],
    "workspaces": local["workspaces"],
    "desktop": local_desktop,
    "remotes": remotes,
  }))

if __name__ == "__main__":
  main()
